# Browser configuration. Paste your project URL and publishable key after =.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Maps JavaScript API browser key and optional cloud map ID.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
# Optional. The inbox address people forward booking confirmations to (shown on Home). Leave empty to hide it.
VITE_BOOKINGS_INBOX_ADDRESS=
