# Browser configuration. Paste your project URL and publishable key after =.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional. Google Maps browser key, restricted to your site in Google Cloud. Leave empty to keep the illustrative map.
VITE_GOOGLE_MAPS_API_KEY=
# Optional. A Map ID from Google Cloud Maps Management. Defaults to the development demo ID.
VITE_GOOGLE_MAP_ID=
